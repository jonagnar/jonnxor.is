---
import { getCollection } from 'astro:content';
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import WallpaperTile from "../components/WallpaperTile.astro";
import { localizedByOrder, requirePageHead } from "../i18n/localized";
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/ui";

const locale = (Astro.currentLocale ?? 'is') as Locale;
const t = useTranslations(locale);

const all = await getCollection('wallpapers');
const walls = localizedByOrder(all, locale);
// First-appearance tag order reproduces the old hardcoded TAGS array.
const tags = [...new Set(walls.map((w) => w.data.tag))];

const pagesAll = await getCollection('pages');
const head = requirePageHead(pagesAll, 'wallpapers', locale).data;
---

<Base title="Wallpaper Stash — JonnXor" page="wallpapers">
  <main>
    <PageHead kicker={head.kicker} title={head.title} lede={head.lede} label="Wallpapers head" />

    <div class="container">
      <div class="rune-divider" aria-hidden="true"><span class="runes"></span></div>

      <div class="wall-filters" id="wall-filters" role="group" aria-label={t('wall.filterLabel')} data-screen-label="Tag filters">
        <button class="chip on" type="button" aria-pressed="true" data-tag="All">{t('wall.all')}</button>
        {tags.map((tag) => (
          <button class="chip" type="button" aria-pressed="false" data-tag={tag}>{tag}</button>
        ))}
      </div>
      <section class="masonry" id="masonry" data-screen-label="Masonry grid">
        {walls.map((w) => (
          <WallpaperTile
            slug={w.data.slug} title={w.data.title} tag={w.data.tag}
            aspectRatio={w.data.aspect_ratio} gradient={w.data.gradient} angle={w.data.angle}
          />
        ))}
      </section>
    </div>
  </main>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label={t('wall.preview')}>
    <div class="lb-frame">
      <div class="lb-art" id="lb-art"></div>
      <div class="lb-bar">
        <span class="lb-title" id="lb-title"></span>
        <span class="chip" id="lb-res">1920 × 1080</span>
        <button class="btn btn-gold" type="button" id="lb-download">{t('wall.download')}</button>
        <button class="btn btn-ghost" type="button" id="lb-close">{t('wall.close')}</button>
      </div>
    </div>
  </div>

  <script is:inline slot="end">
(function () {
  'use strict';
  var tiles = document.querySelectorAll('#masonry .wall-tile');
  var chips = document.querySelectorAll('#wall-filters .chip');
  var lb = document.getElementById('lightbox');
  var lbArt = document.getElementById('lb-art');
  var lbTitle = document.getElementById('lb-title');
  var lbClose = document.getElementById('lb-close');
  var current = null;
  var lastFocused = null;

  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      var tag = chip.getAttribute('data-tag');
      chips.forEach(function (c) {
        var on = c === chip;
        c.classList.toggle('on', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      tiles.forEach(function (tile) {
        tile.hidden = tag !== 'All' && tile.getAttribute('data-tag') !== tag;
      });
    });
  });

  document.getElementById('masonry').addEventListener('click', function (e) {
    var tile = e.target.closest('.wall-tile');
    if (!tile) return;
    current = tile.dataset;
    // Read the gradient the tile already painted — keeps the formula in ONE place (the component).
    lbArt.style.background = tile.querySelector('.w-art').style.background;
    lbTitle.textContent = current.title;
    lastFocused = document.activeElement;
    lb.classList.add('open');
    lbClose.focus();
  });

  function closeLb() {
    if (!lb.classList.contains('open')) return;
    lb.classList.remove('open');
    // Restore focus to the opening tile; if it was filtered out meanwhile,
    // fall back to the active filter chip.
    var target = (lastFocused && !lastFocused.hidden) ? lastFocused : document.querySelector('#wall-filters .chip.on');
    if (target) target.focus();
    lastFocused = null;
  }
  lbClose.addEventListener('click', closeLb);
  lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeLb(); return; }
    if (e.key !== 'Tab' || !lb.classList.contains('open')) return;
    // Focus trap: cycle between the lightbox's two focusable controls
    // (Download, then Close in DOM order) while open.
    var focusables = lb.querySelectorAll('#lb-download, #lb-close');
    var first = focusables[0];
    var last = focusables[focusables.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus(); }
    } else {
      if (document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  // Real download: paint the gradient to a canvas and save it. This re-derives
  // the raw stops (unlike the lightbox background above) because canvas
  // addColorStop needs the raw hex values, not a CSS background shorthand.
  document.getElementById('lb-download').addEventListener('click', function () {
    if (!current) return;
    var c = document.createElement('canvas');
    c.width = 1920; c.height = 1080;
    var ctx = c.getContext('2d');
    var rad = (parseInt(current.angle, 10) - 90) * Math.PI / 180;
    var x = Math.cos(rad) * 960, y = Math.sin(rad) * 540;
    var g = ctx.createLinearGradient(960 - x, 540 - y, 960 + x, 540 + y);
    g.addColorStop(0, current.g0);
    g.addColorStop(.55, current.g1);
    g.addColorStop(1, current.g2);
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, 1920, 1080);
    ctx.fillStyle = 'rgba(255,255,255,.5)';
    ctx.font = '600 28px Orbitron, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('ᛞ', 960, 556);
    var a = document.createElement('a');
    // Filename derives from the title with the original regex — NOT the slug —
    // so download names stay byte-identical to the pre-port page (e.g. the old
    // name for 'Kettle & Cat' is kettle-cat-…, but its slug is kettle-and-cat).
    a.download = current.title.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '-1920x1080.png';
    a.href = c.toDataURL('image/png');
    a.click();
  });
})();
  </script>
</Base>

<style is:global>
  .wall-tile[hidden] { display: none; }
  .wall-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 30px; }
  .wall-filters .chip { cursor: pointer; user-select: none; }
  .wall-filters .chip.on { color: var(--tq-ink); background: var(--tq-soft); border-color: var(--tq-deep); }

  .masonry { columns: 3 280px; column-gap: 18px; }
  .wall-tile {
    break-inside: avoid;
    margin-bottom: 18px;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    cursor: zoom-in;
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    text-align: left;
    transition: transform .25s var(--ease-out), box-shadow .25s;
  }
  .wall-tile:hover { transform: translateY(-3px); box-shadow: 0 0 var(--glow-r) var(--glow-tq), var(--shadow); }
  .wall-tile .w-art { display: grid; place-items: center; color: rgba(255,255,255,.85); }
  .wall-tile .w-mark { font-family: var(--font-display); font-weight: 800; letter-spacing: .2em; font-size: 13px; opacity: .85; text-shadow: 0 1px 10px rgba(0,0,0,.5); }
  .wall-tile .w-bar {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: linear-gradient(to top, rgba(4,6,10,.78), transparent);
    color: #fff;
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: .1em;
  }
  .wall-tile .w-bar .chip { background: rgba(255,255,255,.12); border-color: transparent; color: rgba(255,255,255,.85); }
</style>

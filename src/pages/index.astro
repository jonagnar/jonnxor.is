---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostRow from "../components/PostRow.astro";
import { localizedEntry, requirePageHead, uniqueSlugs } from "../i18n/localized";
import { defaultLocale, type Locale } from "../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { HomeSections } from "../content/page-sections";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

const pagesAll = await getCollection('pages');
const head = requirePageHead(pagesAll, 'home', locale).data;
const sections = head.sections as HomeSections;

const allPosts = (await getCollection("blog")).filter((p) => !p.data.draft);
const posts = uniqueSlugs(allPosts)
  .map((slug) => localizedEntry(allPosts, slug, locale))
  .filter((p): p is NonNullable<typeof p> => p != null)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const ACCENT: Record<string, string> = { "Engineering": "tq", "Games × Code": "gold" };
const dateLocale = { is: "is-IS", en: "en-GB", ja: "ja-JP" }[locale] ?? "en-GB";
---

<Base title="JonnXor — Jón Agnar Stefánsson" page="home" dragonfly="on">
  <main>
    <section class="hero" data-screen-label="Home hero">
      <div class="container hero-grid">
        <div>
          <p class="kicker">{head.kicker}</p>
          <h1>JONN<span class="xor">XOR</span></h1>
          <p class="real-name">Jón Agnar Stefánsson</p>
          <p class="tagline">{sections.hero.tagline}</p>
          <div class="hero-ctas">
            <a class="btn btn-gold" href="/portfolio">{sections.hero.cta_primary}</a>
            <a class="btn btn-ghost" href="/about">{sections.hero.cta_secondary}</a>
          </div>
        </div>
        <div class="hero-dragon" aria-hidden="true">
          <svg viewBox="0 0 440 340" fill="none">
            <g class="lines" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <!-- head -->
              <path d="M392 86 L352 64 L334 30 M352 64 L322 92 L286 132 M392 86 L350 102 L322 92" />
              <!-- wing -->
              <path d="M286 132 L262 44 L218 86 L180 64 L196 122 L286 132" />
              <!-- body -->
              <path d="M286 132 L240 176 L186 196 L196 122" />
              <!-- legs -->
              <path d="M240 176 L250 218 L234 240 M186 196 L188 234" />
              <!-- tail -->
              <path d="M186 196 L118 226 L62 204 L28 256 M28 256 L44 246 M28 256 L40 264" />
            </g>
            <g class="stars">
              <circle cx="392" cy="86" r="3.4" /><circle cx="352" cy="64" r="2.6" /><circle cx="334" cy="30" r="3.4" />
              <circle cx="322" cy="92" r="2.6" /><circle cx="350" cy="102" r="2.2" />
              <circle cx="286" cy="132" r="3.8" /><circle cx="262" cy="44" r="3.4" /><circle cx="218" cy="86" r="2.6" />
              <circle cx="180" cy="64" r="3.4" /><circle cx="196" cy="122" r="2.6" />
              <circle cx="240" cy="176" r="3.4" /><circle cx="250" cy="218" r="2.2" /><circle cx="234" cy="240" r="2.6" />
              <circle cx="186" cy="196" r="3.4" /><circle cx="188" cy="234" r="2.2" />
              <circle cx="118" cy="226" r="2.6" /><circle cx="62" cy="204" r="2.6" /><circle cx="28" cy="256" r="3.4" />
            </g>
            <text class="caption" x="220" y="318" text-anchor="middle">Drekinn · the dragon constellation</text>
          </svg>
        </div>
      </div>
    </section>

    <div class="container">
      <div class="rune-divider" aria-hidden="true"><span class="runes"></span></div>

      <section data-screen-label="Three paths">
        <div class="paths">
          {sections.paths.map((p, i) => (
            <a class="card lift path-card reveal" href={["/portfolio", "/blog", "/games"][i]}>
              <span class="path-rune">{p.rune}</span>
              <h3>{p.title}</h3>
              <p>{p.copy}</p>
              <span class="go">{p.link_label}</span>
            </a>
          ))}
        </div>
      </section>

      <div class="rune-divider" aria-hidden="true"><span class="runes"></span></div>

      <section data-screen-label="Now strip">
        <p class="kicker gold">{sections.now_kicker}</p>
        <div class="now-strip">
          {sections.now.map((n) => (
            <div class="card now-card reveal">
              <div class="now-label">{n.label}</div>
              <div class="now-value">{n.value}</div>
              <div class="now-sub">{n.sub}</div>
            </div>
          ))}
        </div>
      </section>

      <div class="rune-divider" aria-hidden="true"><span class="runes"></span></div>

      <section class="home-posts" data-screen-label="Latest writing">
        <p class="kicker">{sections.latest_heading}</p>
        {posts.map((post) => (
          <PostRow
            href={getRelativeLocaleUrl(locale, `/blog/${post.data.slug}`)}
            date={post.data.date}
            dateLocale={dateLocale}
            title={post.data.title}
            category={post.data.category}
            accent={ACCENT[post.data.category]}
          />
        ))}
      </section>
    </div>
  </main>
</Base>

<style is:global>
  .hero {
    background: var(--aurora);
    padding: 72px 0 24px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 40px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(44px, 7vw, 76px);
    font-weight: 900;
    letter-spacing: .06em;
    margin: 0 0 6px;
  }
  .hero h1 .xor { color: var(--tq-ink); text-shadow: 0 0 var(--glow-r) var(--glow-tq); }
  .hero .real-name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--gold-ink);
    margin: 0 0 22px;
  }
  .hero .tagline {
    font-size: 18px;
    color: var(--ink-soft);
    max-width: 46ch;
    margin-bottom: 30px;
  }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-dragon { display: grid; place-items: center; }
  .hero-dragon svg { width: 100%; max-width: 460px; height: auto; }
  .hero-dragon .lines {
    stroke: var(--tq);
    filter: drop-shadow(0 0 calc(var(--glow-r) * .5) var(--glow-tq));
  }
  .hero-dragon .stars { fill: var(--gold); filter: drop-shadow(0 0 calc(var(--glow-r) * .4) var(--glow-gold)); }
  .hero-dragon .caption {
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: .3em;
    text-transform: uppercase;
    fill: var(--ink-faint);
  }
  @media (max-width: 880px) {
    .hero { padding-top: 48px; }
    .hero-grid { grid-template-columns: 1fr; }
    .hero-dragon { order: -1; }
    .hero-dragon svg { max-width: 320px; }
  }

  .paths { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  @media (max-width: 880px) { .paths { grid-template-columns: 1fr; } }
  .path-card { padding: 26px; display: flex; flex-direction: column; gap: 8px; color: var(--ink); }
  .path-card:hover { text-decoration: none; }
  .path-card .path-rune {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .2em;
    color: var(--tq-ink);
  }
  .path-card h3 { font-size: 18px; margin: 0; }
  .path-card p { color: var(--ink-soft); font-size: 14.5px; margin: 0; }
  .path-card .go { font-family: var(--font-display); font-size: 11px; letter-spacing: .14em; color: var(--gold-ink); margin-top: 8px; }

  .now-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  @media (max-width: 880px) { .now-strip { grid-template-columns: 1fr; } }
  .now-card { padding: 20px 22px; }
  .now-card .now-label {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 8px;
  }
  .now-card .now-value { font-family: var(--font-display); font-size: 16px; font-weight: 700; }
  .now-card .now-sub { font-size: 13px; color: var(--ink-soft); margin-top: 4px; }

  .home-posts .post-row {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .home-posts .post-row:hover { text-decoration: none; background: var(--tq-soft); }
  .home-posts .post-date {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-faint);
    min-width: 92px;
  }
  .home-posts .post-title { font-family: var(--font-display); font-weight: 600; font-size: 15px; letter-spacing: .03em; }
  .home-posts .post-tag { margin-left: auto; }
  @media (max-width: 600px) {
    .home-posts .post-tag { display: none; }
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import CountdownCard from "../components/CountdownCard.astro";
import CountUpCard from "../components/CountUpCard.astro";
import { localizedEntry, requirePageHead, uniqueSlugs } from "../i18n/localized";
import type { Locale } from "../i18n/ui";

const locale = (Astro.currentLocale ?? 'is') as Locale;

const all = await getCollection('countdowns');
const entries = uniqueSlugs(all)
  .map((s) => localizedEntry(all, s, locale))
  .filter((e): e is NonNullable<typeof e> => Boolean(e))
  .sort((a, b) => a.data.order - b.data.order);
const downs = entries.filter((e) => e.data.kind === 'countdown');
const ups = entries.filter((e) => e.data.kind === 'countup');

const pagesAll = await getCollection('pages');
const page = requirePageHead(pagesAll, 'countdowns', locale).data;
const sections = page.sections as { countdown_kicker: string; countup_kicker: string; methodology: string };
---

<Base title="Countdowns — JonnXor" page="countdowns">
  <main>
    <PageHead kicker={page.kicker} title={page.title} lede={page.lede} label="Countdowns head" />

    <div class="container">
      <div class="rune-divider" aria-hidden="true"><span class="runes"></span></div>

      <section data-screen-label="Countdowns">
        <p class="kicker">{sections.countdown_kicker}</p>
        <div class="cd-grid" id="cd-grid">
          {downs.map((e) => (
            <CountdownCard what={e.data.what} when={e.data.when} note={e.data.note} gold={e.data.gold} />
          ))}
        </div>
      </section>

      <div class="rune-divider" aria-hidden="true"><span class="runes"></span></div>

      <section data-screen-label="Count-ups">
        <p class="kicker gold">{sections.countup_kicker}</p>
        <div class="up-grid" id="up-grid">
          {ups.map((e, i) => (
            <CountUpCard icon={e.data.icon} what={e.data.what} note={e.data.note} start={e.data.start} rate={e.data.rate} index={i} />
          ))}
        </div>
        <p class="up-method">{sections.methodology}</p>
      </section>
    </div>
  </main>

  <script is:inline slot="end">
(function () {
  'use strict';
  function pad(n) { return n < 10 ? '0' + n : '' + n; }

  var cdCards = document.querySelectorAll('#cd-grid .cd-card[data-when]');
  var upEntries = Array.prototype.map.call(
    document.querySelectorAll('#up-grid [data-up]'),
    function (el) {
      return {
        el: el,
        start: new Date(el.getAttribute('data-start')),
        rate: parseFloat(el.getAttribute('data-rate')),
      };
    }
  );

  function tick() {
    var now = Date.now();
    cdCards.forEach(function (card) {
      var r = window.JX.daysUntil(card.getAttribute('data-when'));
      card.querySelectorAll('.cd-num[data-u]').forEach(function (el) {
        var u = el.getAttribute('data-u');
        var v = r.past ? 0 : r[u];
        el.textContent = u === 'd' ? v : pad(v);
      });
    });
    upEntries.forEach(function (entry) {
      var days = (now - entry.start.getTime()) / 86400000 * (entry.rate / 24);
      entry.el.textContent = days.toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
    });
  }

  tick();
  setInterval(tick, 100);
})();
  </script>
</Base>

<style is:global>
  .cd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
  .cd-card { padding: 22px; }
  .cd-card .cd-what { font-family: var(--font-display); font-size: 14px; font-weight: 700; letter-spacing: .06em; margin-bottom: 2px; }
  .cd-card .cd-when { font-family: var(--font-mono); font-size: 12px; color: var(--ink-faint); margin-bottom: 16px; }
  .cd-card .cd-clock { display: flex; gap: 10px; }
  .cd-card .cd-cell { text-align: center; flex: 1; background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-sm); padding: 8px 2px 6px; }
  .cd-card .cd-num { font-family: var(--font-display); font-size: 20px; font-weight: 800; color: var(--tq-ink); text-shadow: 0 0 calc(var(--glow-r) * .6) var(--glow-tq); font-variant-numeric: tabular-nums; }
  .cd-card .cd-lbl { font-family: var(--font-display); font-size: 9px; letter-spacing: .18em; color: var(--ink-faint); text-transform: uppercase; margin-top: 2px; }
  .cd-card.gold .cd-num { color: var(--gold-ink); text-shadow: 0 0 calc(var(--glow-r) * .6) var(--glow-gold); }

  .up-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
  .up-card { padding: 22px; }
  .up-card .up-icon { font-size: 20px; margin-bottom: 8px; color: var(--tq-ink); }
  .up-card .up-num { font-family: var(--font-display); font-size: 26px; font-weight: 800; color: var(--gold-ink); text-shadow: 0 0 calc(var(--glow-r) * .5) var(--glow-gold); font-variant-numeric: tabular-nums; }
  .up-card .up-num small { font-size: 14px; font-weight: 600; color: var(--ink-faint); text-shadow: none; }
  .up-card .up-what { font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-soft); margin-top: 4px; }
  .up-card .up-note { font-size: 12.5px; color: var(--ink-faint); margin: 8px 0 0; }
  .up-method { font-size: 12.5px; color: var(--ink-faint); margin-top: 18px; }
</style>

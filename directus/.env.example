# CLIENT-side Directus env — consumed by the content scripts in client/
# (content:pull / content:restore / content:import / directus:schema) via
# `node --env-file=../directus/.env`.
#
# The Directus STACK (compose, full stack env, data/, uploads/) lives in the
# infra repo: ~/dev/src/infra/directus — see its README for up/down + runbook.

# Where the scripts reach the running stack (published port on localhost)
DIRECTUS_URL=http://localhost:8055

# Admin credentials the scripts log in with (must match the stack's env in infra)
ADMIN_EMAIL=admin@jonnxor.is
ADMIN_PASSWORD=replace-with-strong-local-password
